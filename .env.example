# Development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota
DJANGO_ADMIN_URL=admin/
DJANGO_SESSION_COOKIE_AGE=28800

# Production HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_TRUST_X_REAL_IP=false

# Antiabuso (contadores compartidos en base de datos)
DJANGO_REQUEST_RATE_LIMIT=5
DJANGO_REQUEST_RATE_LIMIT_WINDOW=900
DJANGO_ADMIN_LOGIN_IP_LIMIT=20
DJANGO_ADMIN_LOGIN_USER_LIMIT=30
DJANGO_ADMIN_LOGIN_PAIR_LIMIT=8
DJANGO_ADMIN_LOGIN_WINDOW=900

# SMTP (used when DJANGO_DEBUG=false)
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=webmaster@example.com
DJANGO_CONTACT_TO_EMAIL=
